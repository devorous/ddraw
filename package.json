{
  "name": "top-draw",
  "version": "1.15.1-beta",
  "description": "A multiplayer drawing application with WebSocket support",
  "type": "module",
  "scripts": {
    "dev": "concurrently \"npm run server\" \"vite --open /go/\"",
    "dev:lan": "concurrently \"npm run server\" \"vite --host\"",
    "build": "vite build",
    "build:itch": "vite build && node scripts/itch-patch.js",
    "build:preview": "npm run build && npm run preview",
    "vite": "vite",
    "preview": "vite preview",
    "server": "cross-env HOST=127.0.0.1 PORT=8030 node server/index.js",
    "test:sync": "node testing/run-sync.mjs",
    "test:ddrawcodec": "node testing/devtools/ddraw_codec_roundtrip.mjs",
    "test:snapshotformat": "node testing/devtools/snapshot_format_roundtrip.mjs",
    "test:parity": "node testing/devtools/replay_parity_suite.mjs",
    "test:k6parity": "node testing/devtools/k6_ddraw_parity.mjs",
    "test:k6edge": "node testing/devtools/replay_multiuser_edge_suite.mjs",
    "test:undosnap": "node testing/devtools/replay_undo_after_snapshot.mjs",
    "test:syncstate": "node testing/devtools/sync_state_join_suite.mjs",
    "test:selparity": "node testing/devtools/selection_parity_suite.mjs",
    "test:k6obs": "node testing/devtools/k6_lowstress_observers.mjs",
    "test:bakedefer": "node testing/devtools/bake_defer_ab.mjs",
    "test:wslatency": "node testing/devtools/ws_latency_probe.mjs",
    "test:brushjoin": "node testing/devtools/image_brush_joiner_render_probe.mjs",
    "test:brushwire": "node testing/devtools/image_brush_join_probe.mjs",
    "test:moderation": "node testing/puppeteer/moderation_suite.js",
    "test:ipidentity": "node testing/moderation/ip_identity.test.mjs",
    "test:ipmod": "cross-env MONGODB_URI=mongodb://127.0.0.1:27017 MONGODB_DB_NAME=Draw node testing/moderation/ip_moderation_suite.mjs",
    "server:stress": "cross-env HOST=127.0.0.1 PORT=8030 DISABLE_RATE_LIMITS=true node server/index.js",
    "snapshots:cleanup-legacy": "node server/scripts/delete-legacy-snapshots.js",
    "dev:stress": "concurrently \"npm run server:stress\" \"vite --open /go/\"",
    "start": "node server/index.js",
    "docs": "jsdoc -r src server shared -d docs/jsdocs",
    "wasm": "wasm-pack build wasm_src --target web --out-dir ../src/wasm/",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build",
    "tauri:update": "node scripts/release/tauri-update.mjs",
    "tauri:update:publish": "node scripts/release/tauri-update.mjs --publish-only",
    "tauri:update:stage": "node scripts/release/tauri-update.mjs --stage-only",
    "steam:build": "node scripts/release/steam-build.mjs",
    "steam:stage": "node scripts/release/steam-build.mjs --no-build",
    "release:set": "node scripts/release/versioning.mjs set",
    "release:patch": "node scripts/release/versioning.mjs patch",
    "release:minor": "node scripts/release/versioning.mjs minor",
    "release:major": "node scripts/release/versioning.mjs major",
    "release:prepatch": "node scripts/release/versioning.mjs prepatch",
    "release:preminor": "node scripts/release/versioning.mjs preminor",
    "release:premajor": "node scripts/release/versioning.mjs premajor",
    "release:beta": "node scripts/release/versioning.mjs beta",
    "release:promote": "node scripts/release/versioning.mjs promote",
    "update:set": "node scripts/release/update-set.mjs",
    "discord:update": "node scripts/post-discord-update.mjs",
    "test:concurrent": "node testing/devtools/concurrent_draw_undo_suite.mjs",
    "test:tapediff": "node testing/devtools/tape_compare.mjs",
    "test:afksoak": "node testing/devtools/afk_idle_soak_suite.mjs",
    "test:afkactivity": "node testing/devtools/afk_activity_probe.mjs",
    "test:joinerbisect": "node testing/devtools/joiner_content_bisect.mjs",
    "dev:reset": "node scripts/dev-backend-reset.mjs",
    "migrate:timelapses": "node scripts/migrate-timelapses.mjs",
    "server:local": "cross-env MONGODB_URI=mongodb://127.0.0.1:27017 MONGODB_DB_NAME=Draw R2_ENDPOINT=http://127.0.0.1:9000 R2_ACCESS_KEY_ID=minioadmin R2_SECRET_ACCESS_KEY=minioadmin R2_BUCKET_NAME=gallery R2_PUBLIC_URL=http://127.0.0.1:9000/gallery R2_FORCE_PATH_STYLE=true R2_SNAPSHOTS_BUCKET=snapshots R2_SNAPSHOTS_ACCESS_KEY_ID=minioadmin R2_SNAPSHOTS_SECRET_ACCESS_KEY=minioadmin R2_SNAPSHOTS_SECRET_KEY=minioadmin ALLOW_DEV_SNAPSHOTS=true DISABLE_RATE_LIMITS=true HOST=127.0.0.1 PORT=8030 node server/index.js",
    "dev:local": "concurrently \"npm run server:local\" \"vite --open /go/\"",
    "test:k6audit": "node testing/devtools/k6_wire_audit.mjs"
  },
  "devDependencies": {
    "@tauri-apps/api": "2.10.1",
    "@tauri-apps/cli": "2.10.1",
    "concurrently": "^10.0.3",
    "cross-env": "^10.1.0",
    "jsdoc": "^4.0.5",
    "mitata": "^1.0.34",
    "puppeteer": "^22.15.0",
    "sass": "^1.97.3",
    "sass-embedded": "^1.97.3",
    "svelte": "^5.55.0",
    "vite": "^5.0.0",
    "vite-plugin-pwa": "^1.3.0"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1011.0",
    "@fingerprintjs/fingerprintjs": "^5.2.0",
    "@sveltejs/vite-plugin-svelte": "^4.0.4",
    "@tauri-apps/plugin-process": "2.3.1",
    "@tauri-apps/plugin-shell": "2.3.5",
    "@tauri-apps/plugin-updater": "2.10.1",
    "@vercel/analytics": "^2.0.1",
    "bcrypt": "^6.0.0",
    "delaunator": "^5.0.1",
    "discord.js": "^14.26.4",
    "dotenv": "^17.2.4",
    "geoip-lite": "^1.4.10",
    "jsonwebtoken": "^9.0.3",
    "maxmind": "^5.0.6",
    "mongodb": "^7.1.0",
    "perfect-freehand": "^1.2.3",
    "protobufjs": "^8.0.0",
    "reinvented-color-wheel": "^0.4.0",
    "sharp": "^0.34.5",
    "stackblur": "^1.0.0",
    "stripe": "^22.3.1",
    "webm-muxer": "^5.1.4",
    "ws": "^8.14.0"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "license": "MIT"
}
