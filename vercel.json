{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Permissions-Policy",
          "value": "browsing-topics=(), run-ad-auction=(), join-ad-interest-group=(), private-state-token-redemption=(), private-state-token-issuance=(), private-aggregation=(), attribution-reporting=()"
        }
      ]
    }
  ],
  "rewrites": [
    { "source": "/chat", "destination": "/chat/index.html" },
    { "source": "/chat/(.*)", "destination": "/chat/index.html" },
    { "source": "/download", "destination": "/api/download" },
    { "source": "/go", "destination": "/go/index.html" },
    { "source": "/go/(.*)", "destination": "/go/index.html" },
    { "source": "/embed", "destination": "/go/index.html" },
    { "source": "/embed/(.*)", "destination": "/go/index.html" },
    {
      "source": "/gallery/:id([a-f0-9]{24})",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": ".*([Bb]ot|[Cc]rawler|[Ss]pider|facebookexternalhit|[Ww]hats[Aa]pp|[Pp]interest|[Ee]mbedly|iframely|vkShare|[Ss]lack|[Dd]iscord|[Tt]elegram|[Ss]kype|[Ff]lipboard|[Pp]review|[Qq]uora|[Mm]astodon).*"
        }
      ],
      "destination": "/api/gallery-preview?id=:id"
    },
    { "source": "/gallery/grid", "destination": "/gallery/grid/index.html" },
    { "source": "/gallery/grid/(.*)", "destination": "/gallery/grid/index.html" },
    { "source": "/gallery", "destination": "/gallery/index.html" },
    { "source": "/gallery/(.*)", "destination": "/gallery/index.html" },
    { "source": "/board", "destination": "/gallery/index.html" },
    { "source": "/board/(.*)", "destination": "/gallery/index.html" },
    { "source": "/user/(.*)", "destination": "/user/index.html" }
  ]
}
